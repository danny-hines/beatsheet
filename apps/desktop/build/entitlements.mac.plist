<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the signed app is allowed under macOS's hardened runtime, which notarizing requires. Kept to what it uses:
  Chromium and Node compile JavaScript as they run (JIT), and Record takes the camera and the microphone. The same
  list goes to everything inside the app (its helper processes do the recording).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
