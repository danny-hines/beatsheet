{
  "name": "@beatsheet/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "beatsheet as a Mac (or Windows) app: the studio in its own window, with the engine and agents running inside it.",
  "updates": {
    "provider": "github",
    "owner": "danny-hines",
    "repo": "beatsheet"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/electron.mjs --dev",
    "start": "npm run build -w @beatsheet/studio && node scripts/build.mjs && electron .",
    "app": "node scripts/make-app.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
