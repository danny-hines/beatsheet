{
  "name": "beatsheet",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @beatsheet/studio",
    "desktop": "npm run start -w @beatsheet/desktop",
    "app": "npm run app -w @beatsheet/desktop",
    "test": "vitest run",
    "typecheck": "tsc -p packages/schema && tsc -p packages/video && tsc -p packages/engine && tsc -p apps/studio",
    "check": "npm run typecheck && npm test && node scripts/validate-examples.ts",
    "beatsheet": "node packages/engine/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
